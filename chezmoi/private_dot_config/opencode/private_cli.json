{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "autoaccept"
  },
  "animations": true,
  "plugins": ["./herdr-opencode"],
  "keybinds": {
    "prompt.stash": "ctrl+s",
    "prompt.stash.pop": "ctrl+s"
  }
}

# Zoxide: add the directory on cd (pwd hook), not at each prompt
if command -v zoxide &> /dev/null; then
  if (( $+functions[_evalcache] )); then
    # Use the cached init script (~4 ms less). The resolved binary path contains
    # the version, so a new zoxide version makes a new cache.
    _evalcache ZOXIDE_BIN=${commands[zoxide]:A} zoxide init zsh --hook pwd
  else
    eval "$(zoxide init zsh --hook pwd)"
  fi
fi


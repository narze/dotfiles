# x86 brew bin (3rd), arm64 brew (2nd)
# `.zshenv` already ran `brew shellenv`, but in a login shell path_helper
# (/etc/zprofile) then moves the brew paths behind the system paths. Put them
# in front again without a new `brew shellenv` (~20 ms each).
for _brew in /usr/local /opt/homebrew; do
  [[ -x $_brew/bin/brew ]] || continue
  if [[ -n $HOMEBREW_PREFIX ]]; then
    path=($_brew/bin $_brew/sbin $path)
    fpath=($_brew/share/zsh/site-functions $fpath)
    export INFOPATH="$_brew/share/info:${INFOPATH:-}"
  else
    eval "$($_brew/bin/brew shellenv)"
  fi
done
unset _brew

# user brew (1st)
if [ -f ~/homebrew/bin/brew ]; then
  eval $(~/homebrew/bin/brew shellenv)
fi

# Cleanup duplicated PATHs (mostly from shellenv evals above), keep the first
path=(${(u)path})


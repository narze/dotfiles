# Extend fpath for custom completions.
fpath=(~/.config/zsh/completions $fpath)

# Completion system. Start it here, before `mise activate`: mise runs
# `compinit -i` from its hook when compdef is missing. Agent shells load other
# plugins (see plugin-managers/zinit.zsh), so they get their own dump file. With
# one shared dump, each context rebuilt it (~265 ms) after the other one ran.
() {
  setopt local_options extended_glob
  local dump=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION
  [[ -n "$CURSOR_AGENT$CLAUDECODE$OPENCODE" ]] && dump+=-agent
  [[ -d ${dump:h} ]] || mkdir -p ${dump:h}
  autoload -Uz compinit
  if [[ -n $dump.checked(#qN.mh-24) ]]; then
    # Checked in the last 24 hours: use the dump as it is (~11 ms).
    compinit -C -d $dump
  else
    # Find new completion files and rebuild the dump if necessary (~30 ms).
    compinit -i -d $dump
    : >| $dump.checked
  fi
}


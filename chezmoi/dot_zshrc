function get_ms() {
  print -- $(( EPOCHREALTIME * 1000 ))
}

if [[ -n "$USE_ZIM" ]]; then
  TIME_START=$(( EPOCHREALTIME * 1000 ))
  source ~/.config/zsh/plugin-managers/zim.zsh
  TIME_END=$(( EPOCHREALTIME * 1000 ))

  if [[ -n "$SHOW_LOAD_TIME" ]]; then
    echo "Time used for zim: ${$((TIME_END - TIME_START))%.*} ms"
  fi
fi


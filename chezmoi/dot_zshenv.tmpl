# Agents write bash, but run it through the login shell (`zsh -c`, `zsh -lc`).
# ai-aligned-zsh turns on bash-like options (word splitting, literal unmatched
# globs, no `=cmd` expansion, ...) only in those non-interactive agent shells.
# Its own detection checks OPENCODE_AI, not OPENCODE, and not AI_AGENT, so force
# it on for those two.
# https://github.com/ai-ecoverse/ai-aligned-zsh (vendored at 2e4f1c4)
[[ -n "$AI_AGENT$OPENCODE" && -z "$AI_ALIGNED_ZSH" ]] && AI_ALIGNED_ZSH=on
# >>> ai-aligned-zsh >>>
[[ -r "$HOME/.local/bin/ai-aligned-zsh" ]] && source "$HOME/.local/bin/ai-aligned-zsh"
# <<< ai-aligned-zsh <<<

# Agent shells (Claude Code, Codex, Cursor, OpenCode) are not interactive, so the
# `mise activate` hook does not keep PATH correct. Use mise shims: a shim picks
# the tool version for its current directory each time it runs, also in daemons
# (for example pitchfork) that are started from the agent shell.
if [[ -n "$AI_AGENT$CLAUDECODE$CODEX_THREAD_ID$CURSOR_AGENT$OPENCODE" ]] && (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi

# Disable T3 Code telemetry (PostHog usage analytics and relay tracing). The
# T3 Code desktop app reads this variable from the login shell when it starts.
export T3CODE_TELEMETRY_ENABLED=false

# Disable telemetry in other CLI tools. DO_NOT_TRACK is the general opt-out
# (https://consoledonottrack.com) that some tools follow. The other variables
# are for tools that do not follow it.
export DO_NOT_TRACK=1
export DISABLE_TELEMETRY=1          # Claude Code
export HOMEBREW_NO_ANALYTICS=1
export NEXT_TELEMETRY_DISABLED=1
export VERCEL_TELEMETRY_DISABLED=1
export WRANGLER_SEND_METRICS=false
export TURBO_TELEMETRY_DISABLED=1
export ASTRO_TELEMETRY_DISABLED=1
export NUXT_TELEMETRY_DISABLED=1

{{ if stat "/opt/homebrew/bin/brew" -}}
# Homebrew environment. chezmoi writes the `brew shellenv` output here when it
# applies this file, so zsh does not start brew each time (~17 ms in every zsh).
# Run `chezmoi apply` again if a new Homebrew version changes this output.
# Like `brew shellenv`, do nothing when PATH already starts with the brew paths.
if [[ $PATH != /opt/homebrew/bin:/opt/homebrew/sbin:* ]]; then
  {{- output "/usr/bin/env" "PATH=/usr/bin:/bin" "/opt/homebrew/bin/brew" "shellenv" "zsh" | trim | nindent 2 }}
fi

{{ end -}}


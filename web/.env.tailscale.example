# Source after .env.example. Replace the hostname and Tailscale login.
HOST_UPDATES_ORIGIN=https://YOUR-HOST.YOUR-TAILNET.ts.net:8445
HOST_UPDATES_TAILSCALE_USER=YOUR-TAILSCALE-LOGIN
# Use a private JSON file with clientId, clientSecret, and numeric ownerId.
HOST_UPDATES_GITHUB_AUTH_FILE="$HOME/Library/Application Support/Host Updates/github-auth.json"
# Optional. Enables the browser terminal with protected sign-in.
HOST_UPDATES_SHELL=/bin/zsh
